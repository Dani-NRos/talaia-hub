[Unit]
Description=Talaia Hub (Meshtastic and MQTT telemetry and alarms)
Documentation=https://github.com/Dani-NRos/talaia-hub
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=talaia
Group=talaia
SupplementaryGroups=dialout
ExecStart=/opt/talaia/node/bin/node /opt/talaia/actual/servidor/src/main.js --config /etc/talaia/config.json
WorkingDirectory=/var/lib/talaia
# /var/lib/talaia, del usuario talaia: base de datos y estado.
StateDirectory=talaia
StateDirectoryMode=0750
Environment=NODE_ENV=production
# Si falla, vuelve a arrancar a los 5 s. Con la configuración mal escrita (salida 2) no insiste: hay que corregirla.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
TimeoutStopSec=15

# Lo justo para leer su configuración, escribir sus datos y abrir el puerto serie.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
