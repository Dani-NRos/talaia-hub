# Cuando Talaia cambia los usuarios de su broker (los escribe en /var/lib/talaia/mosquitto/passwd), se los pasa a
# Mosquitto (talaia-mosquitto.service). Así Talaia no necesita permisos de administrador.
[Unit]
Description=Talaia: vigila los usuarios del broker MQTT para pasárselos a Mosquitto

[Path]
PathChanged=/var/lib/talaia/mosquitto/passwd
Unit=talaia-mosquitto.service

[Install]
WantedBy=multi-user.target
