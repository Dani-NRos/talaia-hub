# Copia a Mosquitto los usuarios que gestiona Talaia y lo recarga (no corta a quien ya está conectado).
[Unit]
Description=Talaia: pasa a Mosquitto los usuarios del broker
After=mosquitto.service

[Service]
Type=oneshot
ExecStart=install -o mosquitto -g mosquitto -m 600 /var/lib/talaia/mosquitto/passwd /etc/mosquitto/talaia.passwd
ExecStart=systemctl reload-or-restart mosquitto.service
